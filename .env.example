# Valores públicos usados por Vite. No guardes secretos en este archivo.
# En producción, define VITE_API_BASE_URL con el dominio HTTPS de la API.
VITE_API_BASE_URL=http://localhost:8080/api

# Solo se usa durante `npm run dev` si las peticiones se hacen a /api.
VITE_API_PROXY_TARGET=http://localhost:8080
